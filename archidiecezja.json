atowicka.pl/o-diecezji/aktualnosci/4120-by-stawac-sie-swiatlem","retrieved":1779667200000},{"title":"Duch Święty nie jest darem dla wybranych","contents":"<p class=\"nspInfo nspInfo1 tright fnull\">24-05-2026</p><a href=\"/o-diecezji/aktualnosci/4119-duch-swiety-nie-jest-darem-dla-wybranych\" class=\"nspImageWrapper tleft fnull gkResponsive\" style=\"margin:0;\" target=\"_self\"><img class=\"nspImage\" src=\"https://archidiecezjakatowicka.pl/modules/mod_news_pro_gk5/cache/2026.zeslanie26nsp-94.jpg\" alt=\"Fot. Antoni Winiarski\"></a><h4 class=\"nspHeader tleft fnull has-image\"><a href=\"/o-diecezji/aktualnosci/4119-duch-swiety-nie-jest-darem-dla-wybranych\" title=\"Duch Święty nie jest darem dla wybranych\" target=\"_self\">Duch Święty nie jest darem dla wybranych</a></h4><p class=\"nspText tleft fnull\">Abp Andrzej Przybylski przewodniczył Mszy i wygłosił homilię w Wigilię Uroczystości Zesłania Ducha Świętego w Katedrze Chrystusa Króla.\n</p>","link":"https://archidiecezjakatowicka.pl/o-diecezji/aktualnosci/4119-duch-swiety-nie-jest-darem-dla-wybranych","retrieved":1779580800000},{"title":"Siedmiu paulinów przyjęło święcenia prezbiteratu na Jasnej Górze","contents":"<p class=\"nspInfo nspInfo1 tright fnull\">23-05-2026</p><a href=\"/o-diecezji/aktualnosci/4118-siedmiu-paulinow-przyjelo-swiecenia-prezbiteratu-na-jasnej-gorze\" class=\"nspImageWrapper tleft fnull gkResponsive\" style=\"margin:0;\" target=\"_self\"><img class=\"nspImage\" src=\"https://archidiecezjakatowicka.pl/modules/mod_news_pro_gk5/cache/2026.swiecenia_paulininsp-94.jpg\" alt=\"Fot. Biuro Prasowe\"></a><h4 class=\"nspHeader tleft fnull has-image\"><a href=\"/o-diecezji/aktualnosci/4118-siedmiu-paulinow-przyjelo-swiecenia-prezbiteratu-na-jasnej-gorze\" title=\"Siedmiu paulinów przyjęło święcenia prezbiteratu na Jasnej Górze\" target=\"_self\">Siedmiu paulinów przyjęło święcenia prezbiteratu na Jasnej Górze</a></h4><p class=\"nspText tleft fnull\">W sobotę, 23 maja, w Bazylice Jasnogórskiej abp Andrzej Przybylski udzielił święceń prezbiteratu siedmiu diakonom Zakonu Ojców Paulinów.\n</p>","link":"https://archidiecezjakatowicka.pl/o-diecezji/aktualnosci/4118-siedmiu-paulinow-przyjelo-swiecenia-prezbiteratu-na-jasnej-gorze","retrieved":1779494400000},{"title":"Śląskie dla Ukrainy","contents":"<p class=\"nspInfo nspInfo1 tright fnull\">23-05-2026</p><a href=\"/o-diecezji/aktualnosci/4117-slaskie-dla-ukrainy\" class=\"nspImageWrapper tleft fnull gkResponsive\" style=\"margin:0;\" target=\"_self\"><img class=\"nspImage\" src=\"https://archidiecezjakatowicka.pl/modules/mod_news_pro_gk5/cache/2026.ukrainansp-94.jpg\" alt=\"Fot. Biuro Prasowe\"></a><h4 class=\"nspHeader tleft fnull has-image\"><a href=\"/o-diecezji/aktualnosci/4117-slaskie-dla-ukrainy\" title=\"Śląskie dla Ukrainy\" target=\"_self\">Śląskie dla Ukrainy</a></h4><p class=\"nspText tleft fnull\">Delegacja Województwa Śląskiego oraz przedstawiciele Archidiecezji Katowickiej odwiedzili Lwów i Krzemieniec.\n</p>","link":"https://archidiecezjakatowicka.pl/o-diecezji/aktualnosci/4117-slaskie-dla-ukrainy","retrieved":1779494400000},{"title":"Gdybyśmy więcej Ducha wzywali, więcej pokoju i jedności między nami by było","contents":"<p class=\"nspInfo nspInfo1 tright fnull\">22-05-2026</p><a href=\"/o-diecezji/aktualnosci/4116-gdybysmy-wiecej-ducha-wzywali-wiecej-pokoju-i-jednosci-miedzy-nami-by-bylo\" class=\"nspImageWrapper tleft fnull gkResponsive\" style=\"margin:0;\" target=\"_self\"><img class=\"nspImage\" src=\"https://archidiecezjakatowicka.pl/modules/mod_news_pro_gk5/cache/2026.bp_wodarczyk_radioemnsp-94.jpg\" alt=\"Fot: radioem.pl\"></a><h4 class=\"nspHeader tleft fnull has-image\"><a href=\"/o-diecezji/aktualnosci/4116-gdybysmy-wiecej-ducha-wzywali-wiecej-pokoju-i-jednosci-miedzy-nami-by-bylo\" title=\"Gdybyśmy więcej Ducha wzywali, więcej pokoju i jedności między nami by było\" target=\"_self\">Gdybyśmy więcej Ducha wzywali, więcej pokoju i jedności między nami by było</a></h4><p class=\"nspText tleft fnull\">Jak rozpoznać, że Duch Święty naprawdę działa w naszym życiu? Bp Adam Wodarczyk w Rozmowie Poranka Radia eM.\n</p>","link":"https://archidiecezjakatowicka.pl/o-diecezji/aktualnosci/4116-gdybysmy-wiecej-ducha-wzywali-wiecej-pokoju-i-jednosci-miedzy-nami-by-bylo","retrieved":1779408000000},{"title":"Spotkanie szkół św. Jana Pawła II Archidiecezji Katowickiej w Rybniku","contents":"<p class=\"nspInfo nspInfo1 tright fnull\">21-05-2026</p><a href=\"/o-diecezji/aktualnosci/4115-spotkanie-szkol-sw-jana-pawla-ii-archidiecezji-katowickiej-w-rybniku\" class=\"nspImageWrapper tleft fnull gkResponsive\" style=\"margin:0;\" target=\"_self\"><img class=\"nspImage\" src=\"https://archidiecezjakatowicka.pl/modules/mod_news_pro_gk5/cache/2026.szkoly_jp2nsp-94.jpg\" alt=\"Fot: Wacław Troszka\"></a><h4 class=\"nspHeader tleft fnull has-image\"><a href=\"/o-diecezji/aktualnosci/4115-spotkanie-szkol-sw-jana-pawla-ii-archidiecezji-katowickiej-w-rybniku\" title=\"Spotkanie szkół św. Jana Pawła II Archidiecezji Katowickiej w Rybniku\" target=\"_self\">Spotkanie szkół św. Jana Pawła II Archidiecezji Katowickiej w Rybniku</a></h4><p class=\"nspText tleft fnull\">21 maja w Bazylice św. Antoniego w Rybnik odbyło się doroczne spotkanie szkół noszących imię św. Jana Pawła II.\n</p>","link":"https://archidiecezjakatowicka.pl/o-diecezji/aktualnosci/4115-spotkanie-szkol-sw-jana-pawla-ii-archidiecezji-katowickiej-w-rybniku","retrieved":1779321600000},{"title":"Bp Witalij Krywicki z wizytą u abp. Andrzeja Przybylskiego","contents":"<p class=\"nspInfo nspInfo1 tright fnull\">18-05-2026</p><a href=\"/o-diecezji/aktualnosci/4113-bp-witalij-krywicki-z-wizyta-u-abp-andrzeja-przybylskiego\" class=\"nspImageWrapper tleft fnull gkResponsive\" style=\"margin:0;\" target=\"_self\"><img class=\"nspImage\" src=\"https://archidiecezjakatowicka.pl/modules/mod_news_pro_gk5/cache/2026.bp_krywickinsp-94.jpg\" alt=\"\"></a><h4 class=\"nspHeader tleft fnull has-image\"><a href=\"/o-diecezji/aktualnosci/4113-bp-witalij-krywicki-z-wizyta-u-abp-andrzeja-przybylskiego\" title=\"Bp Witalij Krywicki z wizytą u abp. Andrzeja Przybylskiego\" target=\"_self\">Bp Witalij Krywicki z wizytą u abp. Andrzeja Przybylskiego</a></h4><p class=\"nspText tleft fnull\">– Serdecznie dziękuję za to, że po raz kolejny odpowiedzieliście na potrzeby Ukrainy, która już od ponad czterech lat cierpi i walczy.\n</p>","link":"https://archidiecezjakatowicka.pl/o-diecezji/aktualnosci/4113-bp-witalij-krywicki-z-wizyta-u-abp-andrzeja-przybylskiego","retrieved":1779062400000}]}